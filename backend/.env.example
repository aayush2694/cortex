# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://YOUR_MAC_USERNAME@localhost:5432/cortex
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5
# Messages each user may send the tutor per day (UTC). Each one is a paid Claude call.
TUTOR_DAILY_LIMIT=30
# "dev" = one local user, no login. "jwt" = GitHub/Google sign-in.
AUTH_MODE=dev
# Set to prod on the live API: it then refuses to start unless AUTH_MODE=jwt.
# ENVIRONMENT=prod
# Signs access tokens in jwt mode; at least 32 bytes (e.g. openssl rand -hex 32).
JWT_SECRET=
# Where sign-in redirects after the provider.
FRONTEND_URL=http://localhost:4200
# GitHub OAuth app credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails allowed to use the AI tutor in jwt mode, comma-separated.
TUTOR_INVITED_EMAILS=
CORS_ORIGINS=["http://localhost:4200"]
