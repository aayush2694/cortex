{
  "name": "cortex",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://cortex-api-w5ew.onrender.com"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
